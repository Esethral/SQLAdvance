INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (181, 6, '[6] MMT VI-1d  Medication: Fills prescriptions within one day.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (182, 6, '[6] MMT VI-1e  Medication: Recognizes side effects.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (183, 6, '[6] MMT VI-1f  Medication: Consults doctor regarding suspected side effects.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (184, 6, '[6] MMT VI-1g  Medication: Leaves medication in original prescription bottle.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (185, 6, '[6] MMT VI-1h  Medication: Knows how to dispose of discontinued medications.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (186, 6, '[6] MMT VI-1i  Medication: Participates in Medication Management training.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (187, 6, '[6] MMT VI-1j  Medication: Discusses medication issues with psychiatrist.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (188, 6, '[6] MMT VI-1k  Medication: Knows contraindications of combining various medications.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (189, 6, '[6] MMT VI-1l  Medication: Does not hoard medications and properly ingests pills at time of administration.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (190, 7, '[7] PT VII-1  Maintains a positive relationship with children.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (191, 7, '[7] PT VII-2  Discusses parenting problems when indicated.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (192, 7, '[7] PT VII-3  Participates in relevant parenting skills training.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (193, 7, '[7] PT VII-4  Discusses single parent issues - visitation - prepares for visits, activities with children.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (194, 7, '[7] PT VII-5  Reality testing for future plans.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (195, 8, '[8] SD VIII-1a  Concept of Time: Knows what time and day it is.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (196, 8, '[8] SD VIII-1b  Concept of Time: Establishes time priorities.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (197, 8, '[8] SD VIII-1c  Concept of Time: Departs with enough time to arrive on time for scheduled activities.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (198, 8, '[8] SD VIII-2a  Time structure: Develops a schedule using a calendar.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (199, 8, '[8] SD VIII-2b  Time structure: Plans at least one activity out of house, work or day treatment center.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (200, 8, '[8] SD VIII-2c  Time structure: Sets own alarm clock to awaken.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (201, 8, '[8] SD VIII-2d  Time structure: Follows through on planned activities.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (202, 8, '[8] SD VIII-3  Is able to read classified ads.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (203, 8, '[8] SD VIII-4  Fills out job applications.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (204, 8, '[8] SD VIII-5  Has appropriate interview skills.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (205, 8, '[8] SD VIII-6  Dresses appropriately to occasion.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (206, 8, '[8] SD VIII-7  Is aware of local educational opportunities.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (207, 8, '[8] SD VIII-8  Able to identify work related symptoms.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (208, 8, '[8] SD VIII-9  Seeks appropriate support systems.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (209, 8, '[8] SD VIII-10  Can write a resume.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (210, 9, '[9] S IX-1  Major portion of non-sleep hours engaged outside bedroom in some type of social interaction.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (211, 9, '[9] S IX-2  Seeks out leisure activities, alone or with others.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (212, 9, '[9] S IX-3  Participates in organized social activities.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (213, 9, '[9] S IX-4  Greets people when entering room and says goodbye when leaving.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (214, 9, '[9] S IX-5  Adjusts to behaviour of the group or individual with whom interacting.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (215, 9, '[9] S IX-6  Keeps abreast of current events in world, community residence and treatment center.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (216, 9, '[9] S IX-7  Up and dressed at an appropriate time on days off and weekends.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (217, 9, '[9] S IX-8  Compromises with others.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (218, 9, '[9] S IX-9  Discusses personal problems and seeks resolutions.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (219, 9, '[9] S IX-10  Has respect for self and others.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (220, 9, '[9] S IX-11  Attends various therapeutic groups.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (221, 9, '[9] S IX-12  Communicates and maintains a conversation.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (222, 9, '[9] S IX-13  Displays appropriate social behaviours.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (223, 9, '[9] S IX-14  Can initiate and maintain friendships.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (224, 9, '[9] S IX-15  Uses language courtesies.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (225, 10, '[10] SA X-1  Knows the dangers of combining psychotropic medication with illegal substances or alcohol.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (226, 10, '[10] SA X-2  Attends NA/AA meeting when indicated.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (229, 10, '[10] SA X-5  Develops support systems to maintain sobriety.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (230, 10, '[10] SA X-6  Recognizes the importance of abstinence.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (231, 10, '[10] SA X-7  Refrains from bringing alcohol or other substances into the CR.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (232, 10, '[10] SA X-8  Discusses substance abuse/alcohol abuse issues with staff.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (233, 10, '[10] SA X-9  Participates in own written relapse prevention planning (identifies triggers and preventions).');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (234, 11, '[11] SM XI-1  Can engage in relaxation.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (235, 11, '[11] SM XI-2  Can do some exercise to reduce anxiety.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (236, 11, '[11] SM XI-3  Discusses personal problems and seeks resolution.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (237, 11, '[11] SM XI-4  Is able to recognize symptoms prior to decompensation.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (238, 11, '[11] SM XI-5  Is able to approach staff to verbalize symptoms associated with illness.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (239, 11, '[11] SM XI-6  Adheres to counseling schedule.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (240, 11, '[11] SM XI-7  Is able to develop coping strategies to deal with internal stressors.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (241, 11, '[11] SM XI-8  Attends to physical ailments appropriately.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (242, 11, '[11] SM XI-9  Demonstrate awareness and able to verbally account for own history of homelessness.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (243, 11, '[11] SM XI-10  Able to identify at least 3 risks of homelessness (psychological and physical well being).');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (244, 11, '[11] SM XI-11  Participates in own written homelessness prevention planning during admission phase (identifying triggers and preventions).');


