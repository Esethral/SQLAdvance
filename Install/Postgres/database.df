INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (1, 1, '[1] AT I-1   Shows adjustment to personal growth.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (2, 1, '[1] AT I-2   Takes some risks for personal growth.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (3, 1, '[1] AT I-3   Accepts constructive criticism.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (4, 1, '[1] AT I-4   Follow through on plans and committments');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (5, 1, '[1] AT I-5   Builds on recognized strengths.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (6, 1, '[1] AT I-6   Handles own sexuality appropriately.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (7, 1, '[1] AT I-7   Identifies decision focus.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (8, 1, '[1] AT I-8   Realizes alternative solutions.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (9, 1, '[1] AT I-9   Consults others.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (10, 1, '[1] AT I-10  Selects an alternative solution and follows through.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (11, 1, '[1] AT I-11  Tries again if results are not effective.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (12, 1, '[1] AT I-12  Responds when spoken to.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (13, 1, '[1] AT I-13  Knows how to handle mail, write a letter, etc.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (14, 1, '[1] AT I-14  Initiates conversation.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (15, 1, '[1] AT I-15  Communicates needs appropriately.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (16, 1, '[1] AT I-16  Seeks assistance when unable to resolve problems.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (17, 1, '[1] AT I-17  Approaches problems directly.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (18, 1, '[1] AT I-18  Accepts responsibility for problems without external blaming.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (19, 1, '[1] AT I-19  Accepts consequences of own behaviour.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (20, 1, '[1] AT I-20  Asks if does not understand.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (21, 1, '[1] AT I-21  Registers disagreements or dissatisifactions and discusses this in a controlled fashion.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (22, 1, '[1] AT I-22  Negotiates medication issues with health care providers.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (23, 1, '[1] AT I-23  Is able to self-advocate in areas of social services and entitlements.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (24, 1, '[1] AT I-24  Is capable of participating in voter registration and election processes.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (25, 2, '[2] CI II-1  Locates bank and gets there.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (26, 2, '[2] CI II-2  Opens bank account and performs all transactions.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (27, 2, '[2] CI II-3  Balances accounts and counts money.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (28, 2, '[2] CI II-4  Makes special space for important papers.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (29, 2, '[2] CI II-5  Knows name and address of funding source (SSI/SSD/PA).');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (30, 2, '[2] CI II-6  Contacts entitlements office.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (31, 2, '[2] CI II-7  Can negotiate social service and entitlement systems.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (32, 2, '[2] CI II-8  Can locate service agencies.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (33, 2, '[2] CI II-9  Can locate hospitals.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (34, 2, '[2] CI II-10  Can mail a letter either in mail box or post office.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (35, 2, '[2] CI II-11  Can use telephone book.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (36, 2, '[2] CI II-12  Locates and uses library if needed.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (37, 2, '[2] CI II-13  Reads bus and train schedules, calls transit info if not sure.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (38, 2, '[2] CI II-14  Knows how to familiarize self with a map.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (39, 2, '[2] CI II-15  Has round trip fare.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (40, 2, '[2] CI II-16  Can locate house of worship.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (41, 2, '[2] CI II-17  Is capable of participating in voting process.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (42, 2, '[2] CI II-18  Seeks out recreational activities, alone or with others.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (43, 2, '[2] CI II-19  Participates in organized community recreational activities.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (44, 2, '[2] CI II-20  Able to maintain peer group support.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (45, 2, '[2] CI II-21  Able to maintain appropriate family support systems.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (46, 2, '[2] CI II-22  Pursues educational opportunities.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (47, 2, '[2] CI II-23  Explores future housing options.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (48, 2, '[2] CI II-24  Understands and recognizes the importance of current placement in a transitional community residence as alternative to homelessness.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (49, 2, '[2] CI II-25  Expresses motivation for graduation from transitional CR to a more independent living situation.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (50, 2, '[2] CI II-26  Participates in realistic planning for discharge to a more independent living situation in the community.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (51, 2, '[2] CI II-27  Expresses knowledge of other residential options and housing resources.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (52, 3, '[3] RC III-1  Participates in treatment goal planning.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (53, 3, '[3] RC III-2  Aware of areas of strengths.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (54, 3, '[3] RC III-3  Aware of deficits and limitations.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (55, 3, '[3] RC III-4  Recognizes need for improvement.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (56, 3, '[3] RC III-5  Can identify and specify behaviours that impede goal setting.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (57, 3, '[3] RC III-6  Can identify and specify behaviours that impede goal attainment.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (58, 3, '[3] RC III-7  Understands the influence of environmental stressors.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (59, 3, '[3] RC III-8  Can generalize newly learned behaviours to other situations outside the program structure.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (60, 3, '[3] RC III-9  Aware of day program reasons for good attendance, routine, etc.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (61, 3, '[3] RC III-10  Discusses specific behaviours to work on regarding rehab, activities: Attendance, task completion, travel training, socialization, ability to follow directions.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (62, 3, '[3] RC III-11  Is able to handle day to day issues and still attend program.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (63, 3, '[3] RC III-12  Uses skills learned in day program in apt program.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (64, 3, '[3] RC III-13  Provides updated list of emergency contact to staff in case of unexplained absence.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (65, 3, '[3] RC III-14  Recognizes/understands own history of unaccounted whereabouts episodes i.e. AWOL, unexplained absence, etc.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (66, 3, '[3] RC III-15  Express understanding of need to be accountable at all times for their own whereabouts by informing staff.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (67, 3, '[3] RC III-16  Demonstrates understanding and proper orientation to residence rules, regulations and activities.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (68, 3, '[3] RC III-17  Demonstrates understanding of risks of unauthorized absence (AWOL).');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (69, 3, '[3] RC III-18  Able to approach staff and verbalize feelings/triggers/impulse to lease unit without staff knowledge/approval, i.e. feeling confined, cabin fever, missing home, family, friends etc.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (70, 3, '[3] RC III-19  Participates/provides written Whereabouts accountability Plan identifying triggers/stimuli of possible AWOL.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (71, 3, '[3] RC III-20  Orientated/understands impact of unexplained absence from residence on entire community.  (Therefore, if AWOL, client should at least call to reassure community of his/her well being) (Harm Reduction)');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (72, 3, '[3] RC III-21  Demonstrate understanding of appropriate planned discharge vs. self initiated discharge against good professional advice.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (227, 10, '[10] SA X-3  Attends MICA programs when indicated.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (73, 3, '[3] RC III-22  Able to account for whereabouts by submitting Residence Request for a Pass form.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (74, 3, '[3] RC III-23  Accounts for whereabouts and well being while on a pass by calling the residence periodically.');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (75, 3, '[3] RC III-24  Knows and understands the process of self initiated discharge (as opposed to AWOL).');
INSERT INTO public.functional_skills (rec_id, medicaid_id, skill_area) VALUES (76, 4, '[4] DLS IV-1a  Food Shopping - Write a shopping list.');
